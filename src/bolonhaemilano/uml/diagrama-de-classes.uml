@startuml
title Bolonha e Milano - Diagrama de Classes (Etapa 2)
skinparam classAttributeIconSize 0
skinparam linetype ortho

class Main {
  + {static} main(args: String[]) : void
}

class Menu {
  - scanner : Scanner
  - emExecucao : boolean
  - jogador : Jogador
  - cidade : Cidade
  + Menu()
  + executar() : void
  - exibirOpcoes() : void
  - lerOpcao() : int
  - processarOpcao(opcao: int) : void
  - iniciarNovoJogo() : void
  - exibirStatusCidade() : void
  - lerNome(pergunta: String) : String
  - exibirSobre() : void
}

class Jogador {
  - nome : String
  - titulo : String
  + Jogador(nome: String)
  + getNome() : String
  + getTitulo() : String
}

class Cidade {
  - nome : String
  - anoAtual : int
  - dono : Jogador
  + Cidade(nome: String, dono: Jogador)
  + avancarAno() : void
  + exibirStatus() : void
}

Main ..> Menu : cria e executa
Menu "1" --> "0..1" Jogador : jogador
Menu "1" --> "0..1" Cidade : cidade
Cidade "1" --> "1" Jogador : dono

note bottom of Menu
  jogador e cidade ficam nulos
  até o jogador escolher "Novo jogo".
end note
@enduml