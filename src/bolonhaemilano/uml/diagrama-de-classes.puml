@startuml
skinparam classAttributeIconSize 0
skinparam nodesep 40
skinparam ranksep 60

class Main {
  + {static} main(args : String[]) : void
}

class Menu {
  - scanner : Scanner
  - emExecucao : boolean
  - partida : Partida
  - cidade : Cidade
  - mercado : Mercado
  - agricultura : Agricultura
  - governo : Governo
  - construcoes : Construcoes
  - nobreza : Nobreza
  + Menu()
  + executar() : void
  - exibirOpcoes() : void
  - lerOpcao() : int
  - processarOpcao(opcao : int) : void
  - iniciarNovoJogo() : void
  - encerrarTurno() : void
  - mostrarClassificacao() : void
  - anunciarVencedor() : void
  - exibirStatusCidade() : void
  - exigirJogoEmAndamento() : boolean
  - abrirMercado() : void
  - lerQuantidade(unidade : String) : int
  - resultado(sucesso : boolean, msgOk : String, msgErro : String) : void
  - abrirAgricultura() : void
  - colher() : void
  - distribuirAlimentos() : void
  - abrirGoverno() : void
  - arrecadarImpostos() : void
  - definirTaxaImposto() : void
  - definirJustica() : void
  - abrirConstrucoes() : void
  - recrutarSoldados() : void
  - construir() : void
  - lerInteiro() : int
  - lerNome(pergunta : String) : String
  - exibirSobre() : void
}

class Jogador {
  - {static} TITULOS : String[]
  - nome : String
  - nivelTitulo : int
  + Jogador(nome : String)
  + getNome() : String
  + getTitulo() : String
  + getNivelTitulo() : int
  + promover() : boolean
  + ehMonarca() : boolean
}

class Cidade {
  - nome : String
  - anoAtual : int
  - florins : int
  - terras : int
  - graos : int
  - servos : int
  - soldados : int
  - construcoes : int
  - taxaImposto : int
  - nivelJustica : String
  - colheitaFeita : boolean
  - impostosArrecadados : boolean
  - dono : Jogador
  + Cidade(nome : String, dono : Jogador)
  + avancarAno() : void
  + marcarColheitaFeita() : void
  + isColheitaFeita() : boolean
  + marcarImpostosArrecadados() : void
  + isImpostosArrecadados() : boolean
  + adicionarFlorins(qtd : int) : void
  + removerFlorins(qtd : int) : boolean
  + adicionarTerras(qtd : int) : void
  + removerTerras(qtd : int) : boolean
  + adicionarGraos(qtd : int) : void
  + removerGraos(qtd : int) : boolean
  + adicionarServos(qtd : int) : void
  + removerServos(qtd : int) : boolean
  + adicionarSoldados(qtd : int) : void
  + removerSoldados(qtd : int) : boolean
  + adicionarConstrucoes(qtd : int) : void
  + removerConstrucoes(qtd : int) : boolean
  + getNome() : String
  + getDono() : Jogador
  + getAnoAtual() : int
  + getFlorins() : int
  + getTerras() : int
  + getGraos() : int
  + getServos() : int
  + getSoldados() : int
  + getConstrucoes() : int
  + getTaxaImposto() : int
  + setTaxaImposto(taxa : int) : void
  + getNivelJustica() : String
  + setNivelJustica(nivel : String) : void
  + exibirStatus() : void
}

class Mercado {
  - {static} PRECO_GRAO : int
  - {static} PRECO_VENDA_GRAO : int
  - {static} PRECO_TERRA : int
  - {static} PRECO_VENDA_TERRA : int
  + comprarGraos(cidade : Cidade, qtd : int) : boolean
  + venderGraos(cidade : Cidade, qtd : int) : boolean
  + comprarTerras(cidade : Cidade, qtd : int) : boolean
  + venderTerras(cidade : Cidade, qtd : int) : boolean
  + getPrecoGrao() : int
  + getPrecoVendaGrao() : int
  + getPrecoTerra() : int
  + getPrecoVendaTerra() : int
}

class Agricultura {
  - {static} HECTARES_POR_SERVO : int
  - {static} PRODUCAO_POR_HECTARE : int
  - {static} HECTARES_POR_SEMENTE : int
  - {static} SERVOS_POR_GRAO : int
  - {static} CRESCIMENTO_PERCENTUAL : int
  - {static} PERCENTUAL_MINIMO : int
  - {static} PERCENTUAL_MAXIMO : int
  + processarColheita(cidade : Cidade) : int
  + distribuirAlimentos(cidade : Cidade, percentual : int) : boolean
  + getPercentualMinimo() : int
  + getPercentualMaximo() : int
}

class Governo {
  + {static} JUSTA : String
  + {static} MODERADA : String
  + {static} SEVERA : String
  - {static} TAXA_MINIMA : int
  - {static} TAXA_MAXIMA : int
  - {static} MULTIPLICADOR_JUSTA : double
  - {static} MULTIPLICADOR_MODERADA : double
  - {static} MULTIPLICADOR_SEVERA : double
  + arrecadarImpostos(cidade : Cidade) : int
  + definirTaxaImposto(cidade : Cidade, taxa : int) : boolean
  + definirJustica(cidade : Cidade, nivel : String) : boolean
  - multiplicadorPara(nivel : String) : double
  + getTaxaMinima() : int
  + getTaxaMaxima() : int
}

class Construcoes {
  - {static} PRECO_SOLDADO : int
  - {static} SERVOS_POR_SOLDADO : int
  - {static} PRECO_CONSTRUCAO : int
  + recrutarSoldados(cidade : Cidade, qtd : int) : boolean
  + construir(cidade : Cidade, qtd : int) : boolean
  + getPrecoSoldado() : int
  + getServosPorSoldado() : int
  + getPrecoConstrucao() : int
}

class Nobreza {
  - {static} PRESTIGIO_MINIMO : int[]
  + calcularPrestigio(cidade : Cidade) : int
  + verificarPromocao(cidade : Cidade) : boolean
}

class Partida {
  + {static} MAXIMO_JOGADORES : int
  - {static} ANO_FINAL : int
  - {static} NOMES_CIDADES : String[]
  - cidades : List<Cidade>
  - indiceAtual : int
  + Partida()
  + {static} nomeDaCidade(indice : int) : String
  + adicionarCidade(cidade : Cidade) : boolean
  + getCidadeAtual() : Cidade
  + getAno() : int
  + passarTurno() : boolean
  + encerrarAno(nobreza : Nobreza) : List<Cidade>
  + terminou() : boolean
  + classificar(nobreza : Nobreza) : List<Cidade>
  + determinarVencedor(nobreza : Nobreza) : Cidade
}

class Testes {
  - {static} aprovados : int
  - {static} reprovados : int
  + {static} main(args : String[]) : void
  - {static} verificar(descricao : String, condicao : boolean) : void
  - {static} titulo(grupo : String) : void
  - {static} novaCidade() : Cidade
  - {static} testarCidade() : void
  - {static} testarMercado() : void
  - {static} testarAgricultura() : void
  - {static} testarGoverno() : void
  - {static} testarConstrucoes() : void
  - {static} testarJogadorENobreza() : void
  - {static} testarPartida() : void
}

Main ..> Menu : cria e executa
Menu "1" o-- "0..1" Partida : partida
Menu "1" o-- "0..1" Cidade : cidade da vez
Menu "1" *-- "1" Mercado : mercado
Menu "1" *-- "1" Agricultura : agricultura
Menu "1" *-- "1" Governo : governo
Menu "1" *-- "1" Construcoes : construcoes
Menu "1" *-- "1" Nobreza : nobreza
Partida "1" o-- "1..4" Cidade : cidades
Cidade "1" --> "1" Jogador : dono
Mercado ..> Cidade : opera sobre
Agricultura ..> Cidade : opera sobre
Governo ..> Cidade : opera sobre
Construcoes ..> Cidade : opera sobre
Nobreza ..> Cidade : calcula prestigio
Nobreza ..> Jogador : promove
Partida ..> Nobreza : usa

Testes ..> Partida : testa as classes de regra

note bottom of Mercado
  Nao guarda nenhuma Cidade:
  recebe a cidade por parametro.
end note

note bottom of Agricultura
  Nao guarda nenhuma Cidade.
  hectares = min(terras, servos x 5)
  sementes = hectares / 2
  producao = hectares x 2
  percentual de distribuicao: 20 a 80
end note

note bottom of Governo
  Nao guarda nenhuma Cidade.
  base = servos x taxa / 100
  multiplicador: Justa 0,8 / Moderada 1,0 / Severa 1,3
  taxa valida: 0 a 50
end note

note bottom of Construcoes
  Nao guarda nenhuma Cidade.
  Soldado: 5 florins + 1 servo (valida os dois
  ANTES de remover qualquer um).
  Construcao: 20 florins.
end note

note bottom of Jogador
  Quem sabe a ORDEM dos titulos.
  TITULOS: Cavaleiro, Barao, Conde,
  Marques, Duque, Rei.
end note

note bottom of Nobreza
  Quem decide QUANDO promover.
  prestigio = construcoes x 10 + soldados x 2
  + servos + terras / 100 (florins nao entram).
  No maximo 1 titulo por ano.
end note

note bottom of Partida
  Rodadas anuais: passarTurno() devolve true
  quando o ultimo jogador encerra (o ano fecha).
  Termina se alguem e Rei ou o ano passa de 1410.
  Vencedor: titulo mais alto; empate, maior prestigio.
end note

note bottom of Cidade
  Recursos (remover* devolve boolean): 1000 florins,
  10000 hectares, 500 graos, 200 servos,
  0 soldados, 0 construcoes.
  Configuracoes: taxaImposto 10%, nivelJustica "Moderada".
  Indicadores anuais: colheitaFeita, impostosArrecadados
  (voltam a false em avancarAno()).
end note

note bottom of Testes
  main proprio (java Testes).
  Padrao: preparar, executar, verificar.
  Termina com System.exit(1) se houver falha.
end note
@enduml
