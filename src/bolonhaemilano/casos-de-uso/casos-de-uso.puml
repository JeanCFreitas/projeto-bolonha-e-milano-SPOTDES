@startuml
left to right direction
skinparam packageStyle rectangle

actor Jogador
actor Desenvolvedor

rectangle "Jogo" {
  usecase "Iniciar novo jogo" as UC1
  usecase "Ver status da cidade" as UC2
  usecase "Ler sobre o jogo" as UC3
  usecase "Negociar no mercado" as UC4
  usecase "Cuidar da agricultura" as UC5
  usecase "Governar a cidade" as UC6
  usecase "Recrutar e construir" as UC7
  usecase "Ver classificacao" as UC8
  usecase "Encerrar turno" as UC9
  usecase "Fechar o ano e promover" as UC9a
  usecase "Anunciar vencedor" as UC9b
  usecase "Sair" as UC0
}

Jogador --> UC1
Jogador --> UC2
Jogador --> UC3
Jogador --> UC4
Jogador --> UC5
Jogador --> UC6
Jogador --> UC7
Jogador --> UC8
Jogador --> UC9
Jogador --> UC0

UC9a ..> UC9 : <<extend>>
UC9b ..> UC9a : <<extend>>

note right of UC4
  Compra e venda de graos e terras.
end note
note right of UC5
  Colher (1 vez por ano)
  e distribuir alimentos.
end note
note right of UC6
  Arrecadar impostos (1 vez por ano),
  definir taxa e nivel de justica.
end note
note right of UC8
  Prestigio de cada cidade
  e meta do proximo titulo.
end note
note bottom of UC2
  Opcoes 2 a 9 exigem jogo em andamento
  (exceto "Ler sobre o jogo").
end note

rectangle "Qualidade" {
  usecase "Executar testes automatizados" as UC10
}

Desenvolvedor --> UC10
@enduml